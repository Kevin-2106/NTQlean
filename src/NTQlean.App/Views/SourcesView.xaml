<UserControl x:Class="NTQlean.App.Views.SourcesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="360"/>
            <ColumnDefinition Width="3*" MinWidth="440"/>
        </Grid.ColumnDefinitions>

        <ui:Card Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="1. 发现 NTQQ 数据目录" Style="{StaticResource SectionTitle}"/>
                <ui:Button Grid.Row="1" Content="自动发现（标准位置，不全盘扫描）"
                           Icon="{ui:SymbolIcon Search24}" HorizontalAlignment="Left"
                           Margin="0,12,0,0" Click="OnDiscoverClick"/>
                <DataGrid Grid.Row="2" x:Name="AccountGrid" MinHeight="260" Margin="0,12,0,0"
                          Style="{StaticResource NtqDataGrid}" SelectionMode="Single"
                          SelectionChanged="OnAccountSelected">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="账号" Binding="{Binding MaskedUin}" Width="100"/>
                        <DataGridTextColumn Header="库合计" Binding="{Binding DbSizeText}" Width="80"/>
                        <DataGridTemplateColumn Header="数据根" Width="*" MinWidth="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Root}" Style="{StaticResource GridCellText}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Grid.Row="3" Margin="0,10,0,0" Style="{StaticResource HintText}"
                           Text="QQ 运行时仍可共享读取；完全退出 QQ 后创建的快照最可靠。"/>
            </Grid>
        </ui:Card>

        <ui:Card Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="2. 确认路径" Style="{StaticResource SectionTitle}"/>

                <TextBlock Grid.Row="1" Text="nt_db（数据库目录，只读）" Style="{StaticResource FormLabel}"/>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="88"/>
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="DbDirBox"/>
                    <ui:Button Grid.Column="1" Content="浏览…" Margin="8,0,0,0" Click="OnBrowseDbClick"/>
                </Grid>

                <TextBlock Grid.Row="3" Text="nt_data（媒体目录，清理目标根）" Style="{StaticResource FormLabel}"/>
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="88"/>
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="DataDirBox"/>
                    <ui:Button Grid.Column="1" Content="浏览…" Margin="8,0,0,0" Click="OnBrowseDataClick"/>
                </Grid>

                <TextBlock Grid.Row="5" Text="工作区（解密副本与索引存放处）" Style="{StaticResource FormLabel}"/>
                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="88"/>
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="WorkspaceBox"/>
                    <ui:Button Grid.Column="1" Content="浏览…" Margin="8,0,0,0" Click="OnBrowseWorkspaceClick"/>
                </Grid>

                <ui:InfoBar Grid.Row="7" x:Name="SafetyBar" Title="安全说明"
                            Message="QQ 原文件只以只读方式打开；解密副本与索引仅写入工作区。"
                            IsClosable="False" Severity="Informational" Margin="0,16,0,0"/>
                <ui:Button Grid.Row="9" Appearance="Primary" Content="下一步：密钥与索引"
                           Icon="{ui:SymbolIcon ArrowRight24}" HorizontalAlignment="Right"
                           MinWidth="180" Margin="0,16,0,0" Click="OnGoIndexClick"/>
            </Grid>
        </ui:Card>
    </Grid>
</UserControl>
