<UserControl x:Class="NTQlean.App.Views.CleanupView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:Card Grid.Row="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="预演报告" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Grid.Column="1" Text="此处不会删除文件" Style="{StaticResource HintText}"
                               VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Grid.Row="1" x:Name="PlanSummaryText" Text="尚无预演结果"
                           Foreground="{StaticResource NtqTextSecondary}" Margin="0,8,0,0"/>
                <TextBox Grid.Row="2" x:Name="ReportBox" Style="{StaticResource OutputTextBox}" Margin="0,10,0,0"/>
            </Grid>
        </ui:Card>

        <ui:Card Grid.Row="1" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ui:InfoBar Title="实际清理（移入回收站，可恢复）"
                            Message="仅处理预演命中且位于所配置 nt_data 根内的文件，并生成 manifest 清单以便追溯。执行前建议完全退出 QQ；回收站清空后文件将无法恢复，重要数据请先备份。"
                            Severity="Warning" IsClosable="False"/>
                <StackPanel Grid.Row="1" x:Name="ExecProgressPanel" Margin="0,12,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="ExecStageText" Text="准备清理…" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource NtqTextSecondary}"/>
                    <ProgressBar x:Name="ExecProgress" Height="4" Margin="0,8,0,0"
                                 Minimum="0" Maximum="1"/>
                </StackPanel>
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text='输入“清理”' VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ui:TextBox Grid.Column="1" x:Name="ConfirmBox"/>
                    <CheckBox Grid.Column="2" x:Name="UnderstandBox" Margin="18,0"
                              VerticalAlignment="Center">
                        <TextBlock Text="我已检查预演报告，理解删除范围与风险，并为重要数据做好了备份"
                                   TextWrapping="Wrap"/>
                    </CheckBox>
                    <ui:Button Grid.Column="3" x:Name="ExecButton" Appearance="Danger"
                               Icon="{ui:SymbolIcon Delete24}" Content="执行清理（回收站）"
                               MinWidth="170" Click="OnExecuteCleanupClick"/>
                </Grid>
            </Grid>
        </ui:Card>
    </Grid>
</UserControl>
