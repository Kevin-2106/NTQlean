<UserControl x:Class="NTQlean.App.Views.SelectView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="280"/>
            <ColumnDefinition Width="*" MinWidth="400"/>
            <ColumnDefinition Width="260" MinWidth="220"/>
        </Grid.ColumnDefinitions>

        <ui:Card Grid.Column="0" Margin="0,0,6,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,6,0">
                    <TextBlock Text="筛选条件" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="类型" Style="{StaticResource FormLabel}"/>
                    <WrapPanel>
                        <CheckBox x:Name="KImage" Content="图片" IsChecked="True" Margin="0,3,12,3"/>
                        <CheckBox x:Name="KVideo" Content="视频" IsChecked="True" Margin="0,3,12,3"/>
                        <CheckBox x:Name="KFile" Content="文件" IsChecked="True" Margin="0,3,12,3"/>
                        <CheckBox x:Name="KPtt" Content="语音" IsChecked="True" Margin="0,3,12,3"/>
                        <CheckBox x:Name="KOther" Content="其他" IsChecked="True" Margin="0,3,12,3"/>
                    </WrapPanel>

                    <TextBlock Text="置信度" Style="{StaticResource FormLabel}"/>
                    <CheckBox x:Name="CExact" Content="exact（路径与大小均吻合）" IsChecked="True" Margin="0,3"/>
                    <CheckBox x:Name="CStrong" Content="strong（路径吻合，大小不一致）" IsChecked="True" Margin="0,3"/>
                    <CheckBox x:Name="CHeuristic" Content="heuristic（路径已失效，按文件名匹配）" Margin="0,3"/>
                    <CheckBox x:Name="COrphan" Content="orphan（无任何数据库记录的文件）" Margin="0,3"/>
                    <CheckBox x:Name="CNoRefOrphan" Content="孤儿中排除聊天记录引用" IsChecked="True" Margin="0,3"/>

                    <TextBlock Text="时间范围" Style="{StaticResource FormLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="从" Style="{StaticResource HintText}" Margin="0,0,0,4"/>
                            <DatePicker x:Name="DateFrom" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="至" Style="{StaticResource HintText}" Margin="0,0,0,4"/>
                            <DatePicker x:Name="DateTo" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,8,0,0">
                        <ui:Button Content="近30天" Click="OnPreset30d" Margin="0,0,6,6"/>
                        <ui:Button Content="今年" Click="OnPresetYear" Margin="0,0,6,6"/>
                        <ui:Button Content="去年" Click="OnPresetLastYear" Margin="0,0,6,6"/>
                        <ui:Button Content="全部" Click="OnPresetAll" Margin="0,0,0,6"/>
                    </WrapPanel>

                    <TextBlock Text="大小范围（MB）" Style="{StaticResource FormLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="最小" Style="{StaticResource HintText}" Margin="0,0,0,4"/>
                            <ui:TextBox x:Name="SizeMin"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="最大" Style="{StaticResource HintText}" Margin="0,0,0,4"/>
                            <ui:TextBox x:Name="SizeMax"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="高级表达式（覆盖时间和大小）" Style="{StaticResource FormLabel}"/>
                    <ui:TextBox x:Name="ExprBox" MinHeight="54" TextWrapping="Wrap" AcceptsReturn="True"/>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,5,0,10"
                               Text="支持 AND / OR / NOT 与括号；字段：time、size、chat、kind、conf、name、path。"/>
                </StackPanel>
            </ScrollViewer>
            <ui:Button Grid.Row="1" x:Name="ApplyFilterButton" Appearance="Primary" Content="应用筛选（预演）"
                       Icon="{ui:SymbolIcon Filter24}" Margin="0,12,0,0" Click="OnApplyFilterClick"/>
            <TextBlock Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Style="{StaticResource HintText}" Margin="0,12,44,0"
                       Text="本页只读，不会删除文件&#x0a;删除仅发生在“④ 清理”页"/>
            </Grid>
        </ui:Card>

        <Grid Grid.Column="1" Margin="6,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" MinHeight="160"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="5*" MinHeight="260"/>
            </Grid.RowDefinitions>

            <ui:Card Grid.Row="0" Margin="0,0,0,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="会话范围" FontWeight="SemiBold"/>
                            <TextBlock Text="选中会话后可排除，等价于 NOT chat" Style="{StaticResource HintText}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:Button Grid.Column="1" Content="排除选中" Margin="8,0,0,0" Click="OnExcludeChatClick"/>
                        <ui:Button Grid.Column="2" Content="清空排除" Margin="8,0,0,0" Click="OnUnexcludeChatClick"/>
                    </Grid>
                    <DataGrid Grid.Row="1" x:Name="ChatGrid" Style="{StaticResource NtqDataGrid}" SelectionMode="Extended">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="会话 ID" Binding="{Binding ChatId}" Width="120"/>
                            <DataGridTextColumn Header="名称" Binding="{Binding DisplayName}" Width="180"/>
                            <DataGridTextColumn Header="媒体" Binding="{Binding ItemsText}" Width="80"/>
                            <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="90"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding ExcludedText}" Width="75"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </ui:Card>

            <Grid Grid.Row="1" Margin="0,6,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="ResultStats" Text="尚未筛选" Foreground="{StaticResource NtqTextSecondary}"/>
                    <ProgressBar x:Name="FilterProgress" Height="4" Margin="0,6,16,0"
                                 IsIndeterminate="True" Visibility="Collapsed"/>
                </StackPanel>
                <ui:Button Grid.Column="1" x:Name="ExportCsvButton" Content="导出 CSV"
                           Icon="{ui:SymbolIcon Save24}" VerticalAlignment="Center" Click="OnExportCsvClick"/>
            </Grid>

            <ui:Card Grid.Row="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="文件结果" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <DataGrid Grid.Row="1" x:Name="ResultGrid" Style="{StaticResource NtqDataGrid}"
                              SelectionMode="Single" SelectionChanged="OnResultSelected"
                              RowDetailsVisibilityMode="Collapsed">
                        <DataGrid.Resources>
                            <ContextMenu x:Key="ResultRowMenu"
                                         DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="打开文件" CommandParameter="{Binding}" Click="OnOpenFileClick"/>
                                <MenuItem Header="打开所在位置" CommandParameter="{Binding}" Click="OnOpenLocationClick"/>
                                <MenuItem Header="复制完整路径" CommandParameter="{Binding}" Click="OnCopyPathClick"/>
                            </ContextMenu>
                        </DataGrid.Resources>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="ContextMenu" Value="{StaticResource ResultRowMenu}"/>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="240"/>
                            <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="70"/>
                            <DataGridTextColumn Header="会话" Binding="{Binding ChatLabel}" Width="160"/>
                            <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="90"/>
                            <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="135"/>
                            <DataGridTextColumn Header="置信度" Binding="{Binding Confidence}" Width="85"/>
                            <DataGridTextColumn Header="消息引用" Binding="{Binding MsgRefsText}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </ui:Card>
        </Grid>

        <ui:Card Grid.Column="2" Margin="6,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="预览" Style="{StaticResource SectionTitle}"/>
                <Border Grid.Row="1" Background="{StaticResource NtqSurfaceDeep}" Height="220"
                        Margin="0,10,0,0" CornerRadius="4" BorderBrush="{StaticResource NtqStroke}" BorderThickness="1">
                    <Image x:Name="PreviewImage" Stretch="Uniform"/>
                </Border>
                <ScrollViewer Grid.Row="2" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="PreviewInfo" FontSize="11" TextWrapping="Wrap"
                               FontFamily="Consolas" Foreground="{StaticResource NtqTextSecondary}"/>
                </ScrollViewer>
            </Grid>
        </ui:Card>
    </Grid>
</UserControl>
