<UserControl x:Class="NTQlean.App.Views.KeysView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" MinWidth="380"/>
            <ColumnDefinition Width="*" MinWidth="400"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,6,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <ui:Card Grid.Row="0" Margin="0,0,0,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="密钥（每个数据库独立）" Style="{StaticResource SectionTitle}"/>
                    <ui:Button Grid.Row="1" x:Name="DumpKeyButton" Appearance="Primary"
                               Icon="{ui:SymbolIcon Key24}" HorizontalAlignment="Left"
                               Content="从运行中的 QQ 提取全部 key" Margin="0,12,0,0"
                               Click="OnDumpKeyClick"/>
                    <TextBlock Grid.Row="2" Style="{StaticResource HintText}" Margin="0,7,0,0"
                               Text="外部只读内存扫描（ReadProcessMemory），不注入、不 hook、不调试、不写入；提取后用数据库 salt 交叉验证。key 只保存在本次运行的内存中，不落盘、不写日志。仅限本人本机账号使用；该操作可能受 QQ 用户协议限制，合规责任由使用者自行承担。"/>
                    <TextBlock Grid.Row="3" Text="手动粘贴 key（可选，来自 ntqlean-probe get-key）" Style="{StaticResource FormLabel}"/>
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="72"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="ManualKeyBox"/>
                        <ui:Button Grid.Column="1" x:Name="ApplyManualKeyButton" Content="应用"
                                   Margin="8,0,0,0" Click="OnApplyManualKeyClick"/>
                    </Grid>
                    <DataGrid Grid.Row="5" x:Name="KeyGrid" MinHeight="150" Margin="0,12,0,0"
                              Style="{StaticResource NtqDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="数据库" Binding="{Binding DbName}" Width="*" MinWidth="125"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="100"/>
                            <DataGridTextColumn Header="key（掩码）" Binding="{Binding KeyMask}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </ui:Card>

            <ui:Card Grid.Row="1" Margin="0,6,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="构建索引" Style="{StaticResource SectionTitle}"/>
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:Button x:Name="BuildButton" Appearance="Primary" Icon="{ui:SymbolIcon Database24}"
                                   Content="构建索引" Click="OnBuildIndexClick"/>
                        <ui:Button Grid.Column="1" x:Name="ForceBuildButton" Content="强制重建"
                                   Margin="8,0,0,0" Tag="force" Click="OnBuildIndexClick"/>
                    </Grid>
                    <CheckBox Grid.Row="2" x:Name="IncludeNtMsgBox"
                              Content="包含 nt_msg 大库（约 13 GB，用于孤儿引用确认）"
                              Margin="0,10,0,0"/>
                    <StackPanel Grid.Row="3" Margin="0,12,0,0">
                        <TextBlock x:Name="BuildStageText" Text="等待构建"
                                   Foreground="{StaticResource NtqTextSecondary}" FontSize="12"/>
                        <ProgressBar x:Name="BuildProgress" Height="4" Margin="0,6,0,0"
                                     IsIndeterminate="True" Visibility="Collapsed"/>
                    </StackPanel>
                    <TextBlock Grid.Row="4" Style="{StaticResource HintText}" Margin="0,10,0,0"
                               Text="覆盖 files_in_chat、rich_media、file_assistant、group_info 和 emoji；nt_msg 按上方选项处理。"/>
                </Grid>
            </ui:Card>
        </Grid>

        <ui:Card Grid.Column="1" Margin="6,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="进度日志" Style="{StaticResource SectionTitle}"/>
                    <Border Grid.Column="1" Background="{StaticResource NtqSurfaceRaised}"
                            CornerRadius="3" Padding="8,3" Margin="12,0,0,0">
                        <TextBlock x:Name="LogStateText" Text="空闲"
                                   Foreground="{StaticResource NtqTextSecondary}" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
                <TextBox Grid.Row="1" x:Name="LogBox" Style="{StaticResource OutputTextBox}"/>
            </Grid>
        </ui:Card>
    </Grid>
</UserControl>
