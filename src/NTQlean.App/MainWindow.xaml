<Window x:Class="NTQlean.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NTQlean — NTQQ 本地存储分析与清理（Phase 2）"
        Width="1280" Height="820" MinWidth="1080" MinHeight="680"
        Background="#1E1E22" Foreground="#DDDDDD"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DDDDDD"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#BBBBBB"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2A2A30"/>
            <Setter Property="Foreground" Value="#EAEAEA"/>
            <Setter Property="BorderBrush" Value="#45454D"/>
            <Setter Property="Padding" Value="4,3"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#2A2A30"/>
            <Setter Property="Foreground" Value="#EAEAEA"/>
            <Setter Property="BorderBrush" Value="#45454D"/>
            <Setter Property="Padding" Value="4,3"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3A3A44"/>
            <Setter Property="Foreground" Value="#EAEAEA"/>
            <Setter Property="BorderBrush" Value="#55555F"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="Margin" Value="2,3"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2A2A30"/>
            <Setter Property="Foreground" Value="#EAEAEA"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#25252B"/>
            <Setter Property="BorderBrush" Value="#45454D"/>
        </Style>
        <Style TargetType="ListView">
            <Setter Property="Background" Value="#25252B"/>
            <Setter Property="BorderBrush" Value="#45454D"/>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#8B2E2E"/>
            <Setter Property="BorderBrush" Value="#B34040"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A8A93"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#161619" Padding="12,8">
            <DockPanel>
                <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="Bold">
                    NTQlean <Run Foreground="#8A8A93" FontSize="12" FontWeight="Normal">— 只读分析 · 副本解密 · 预演清理</Run>
                </TextBlock>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Right" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Foreground="#7FBF7F"/>
            </DockPanel>
        </Border>

        <TabControl x:Name="Tabs" Margin="8">
            <!-- ① 数据源 -->
            <TabItem Header="① 数据源">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <GroupBox Grid.Column="0" Header="1. 发现 NTQQ 数据目录" Foreground="#DDDDDD" Margin="0,0,8,0">
                        <StackPanel Margin="8">
                            <Button Content="自动发现（标准位置，不全盘扫描）" Click="OnDiscoverClick"/>
                            <ListBox x:Name="AccountList" Height="180" Margin="0,8,0,8"
                                     SelectionChanged="OnAccountSelected"/>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="若 QQ 正在运行，索引构建仍可进行（共享读取），但完全退出 QQ 后的快照最可靠。"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Grid.Column="1" Header="2. 确认路径" Foreground="#DDDDDD" Margin="8,0,0,0">
                        <StackPanel Margin="8">
                            <Label Content="nt_db（数据库目录，只读）"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="浏览…" Click="OnBrowseDbClick"/>
                                <TextBox x:Name="DbDirBox" Margin="0,0,6,0"/>
                            </DockPanel>
                            <Label Content="nt_data（媒体目录，清理目标根）"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="浏览…" Click="OnBrowseDataClick"/>
                                <TextBox x:Name="DataDirBox" Margin="0,0,6,0"/>
                            </DockPanel>
                            <Label Content="工作区（解密副本与索引存放处）"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="浏览…" Click="OnBrowseWorkspaceClick"/>
                                <TextBox x:Name="WorkspaceBox" Margin="0,0,6,0"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                                       Text="安全说明：QQ 原文件只以只读方式打开；解密副本与索引仅写入工作区。"/>
                            <Button Content="下一步：构建索引 →" Margin="0,12,0,0" Click="OnGoIndexClick"/>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ② 索引 -->
            <TabItem Header="② 索引">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <Label Content="账号数据库 key（每个账号独立）"/>
                        <PasswordBox x:Name="KeyBox"/>
                        <Button Content="从运行中的 QQ 提取 key（只读内存扫描）" Margin="0,6,0,0"
                                x:Name="DumpKeyButton" Click="OnDumpKeyClick"/>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,8"
                                   Text="key 仅保存在内存中，用于解密工作区内的副本，不落盘、不写入日志。&#x0a;「提取」为外部只读扫描（ReadProcessMemory，不注入不写入），需 QQ 已登录目标账号；仅限本机本人账号使用。也可用社区工具获取后手动粘贴。"/>
                        <Button x:Name="BuildIndexButton" Content="构建索引（解密副本 → 统一索引）" Click="OnBuildIndexClick"/>
                        <Button Content="强制重建（重新解密全部副本）" Margin="0,8,0,0" Tag="force" Click="OnBuildIndexClick"/>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,10,0,0"
                                   Text="索引覆盖 files_in_chat / rich_media / file_assistant / group_info（不含 nt_msg 大库）。构建完成后即可在「③ 选择」中筛选。"/>
                    </StackPanel>
                    <GroupBox Grid.Column="1" Header="进度日志" Foreground="#DDDDDD">
                        <TextBox x:Name="IndexLog" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap" FontFamily="Consolas" Background="#141417"/>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ③ 选择 -->
            <TabItem Header="③ 选择">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="230"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="类型" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="KImage" Content="图片" IsChecked="True"/>
                            <CheckBox x:Name="KVideo" Content="视频" IsChecked="True"/>
                            <CheckBox x:Name="KFile" Content="文件" IsChecked="True"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="KPtt" Content="语音" IsChecked="True"/>
                            <CheckBox x:Name="KOther" Content="其他" IsChecked="True"/>
                        </StackPanel>

                        <TextBlock Text="置信度" FontWeight="Bold" Margin="0,10,0,0"/>
                        <CheckBox x:Name="CExact" Content="exact（路径+大小完全匹配）" IsChecked="True"/>
                        <CheckBox x:Name="CStrong" Content="strong（路径匹配，大小不符）" IsChecked="True"/>
                        <CheckBox x:Name="CHeuristic" Content="heuristic（仅名称相似）"/>
                        <CheckBox x:Name="COrphan" Content="orphan（无数据库引用）"/>

                        <TextBlock Text="时间范围" FontWeight="Bold" Margin="0,10,0,0"/>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="从" Width="30"/>
                            <DatePicker x:Name="DateFrom" Width="130"/>
                            <Label Content="至"/>
                            <DatePicker x:Name="DateTo" Width="130"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="近30天" Click="OnPreset30d"/>
                            <Button Content="今年" Margin="4,0,0,0" Click="OnPresetYear"/>
                            <Button Content="去年" Margin="4,0,0,0" Click="OnPresetLastYear"/>
                            <Button Content="全部" Margin="4,0,0,0" Click="OnPresetAll"/>
                        </StackPanel>

                        <TextBlock Text="大小范围" FontWeight="Bold" Margin="0,10,0,0"/>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="≥" Width="26"/>
                            <TextBox x:Name="SizeMin" Width="80"/>
                            <ComboBox x:Name="SizeMinUnit" Width="56" Margin="4,0,0,0" SelectedIndex="1">
                                <ComboBoxItem>KB</ComboBoxItem><ComboBoxItem>MB</ComboBoxItem><ComboBoxItem>GB</ComboBoxItem>
                            </ComboBox>
                            <Label Content="≤" Width="26" Margin="8,0,0,0"/>
                            <TextBox x:Name="SizeMax" Width="80"/>
                            <ComboBox x:Name="SizeMaxUnit" Width="56" Margin="4,0,0,0" SelectedIndex="2">
                                <ComboBoxItem>KB</ComboBoxItem><ComboBoxItem>MB</ComboBoxItem><ComboBoxItem>GB</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                        <TextBlock Style="{StaticResource HintText}" Text="留空表示不限。"/>

                        <TextBlock Text="高级表达式（可选，覆盖时间/大小）" FontWeight="Bold" Margin="0,10,0,0"/>
                        <TextBox x:Name="ExprBox" Height="44" TextWrapping="Wrap" AcceptsReturn="True"/>
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="例: size &gt;= 10MB AND time &lt; 2025-01-01 AND NOT chat == 123456&#x0a;支持 AND / OR / NOT 与括号；字段: time size chat kind conf name path"/>
                    </StackPanel>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="7*"/>
                        </Grid.RowDefinitions>
                        <GroupBox Grid.Row="0" Header="会话（选中后可加入排除 = NOT）" Foreground="#DDDDDD">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Margin="4">
                                    <Button Content="排除选中" Click="OnExcludeChatClick"/>
                                    <Button Content="清空排除" Margin="0,4,0,0" Click="OnUnexcludeChatClick"/>
                                </StackPanel>
                                <ListBox x:Name="ChatList"/>
                            </DockPanel>
                        </GroupBox>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6">
                            <Button Content="应用筛选（预演）" FontWeight="Bold" Click="OnApplyFilterClick"/>
                            <Button Content="导出 CSV" Margin="8,0,0,0" Click="OnExportCsvClick"/>
                            <TextBlock x:Name="ResultStats" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#7FBF7F"/>
                        </StackPanel>
                        <GroupBox Grid.Row="2" Header="结果（预演，不删除）" Foreground="#DDDDDD">
                            <ListView x:Name="ResultList" SelectionMode="Single"
                                      SelectionChanged="OnResultSelected">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="文件名" Width="240" DisplayMemberBinding="{Binding FileName}"/>
                                        <GridViewColumn Header="类型" Width="60" DisplayMemberBinding="{Binding Kind}"/>
                                        <GridViewColumn Header="会话" Width="150" DisplayMemberBinding="{Binding ChatLabel}"/>
                                        <GridViewColumn Header="大小" Width="90" DisplayMemberBinding="{Binding SizeText}"/>
                                        <GridViewColumn Header="时间" Width="140" DisplayMemberBinding="{Binding TimeText}"/>
                                        <GridViewColumn Header="置信度" Width="80" DisplayMemberBinding="{Binding Confidence}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </GroupBox>
                    </Grid>

                    <GroupBox Grid.Column="2" Header="预览" Foreground="#DDDDDD" Margin="8,0,0,0">
                        <StackPanel>
                            <Border Background="#141417" Height="220" Margin="4">
                                <Image x:Name="PreviewImage" Stretch="Uniform"/>
                            </Border>
                            <TextBlock x:Name="PreviewInfo" FontSize="11" TextWrapping="Wrap" Margin="8"
                                       FontFamily="Consolas"/>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ④ 清理 -->
            <TabItem Header="④ 清理">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <GroupBox Grid.Row="0" Header="预演报告" Foreground="#DDDDDD">
                        <TextBox x:Name="CleanupReportBox" IsReadOnly="True" FontFamily="Consolas"
                                 VerticalScrollBarVisibility="Auto" Background="#141417"/>
                    </GroupBox>
                    <GroupBox Grid.Row="1" Header="实际清理（移入回收站，可恢复）" Foreground="#DDDDDD" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Foreground="#E8A05A" TextWrapping="Wrap"
                                       Text="⚠ 此操作会把「③ 选择」命中的文件移入系统回收站（可还原）。执行前请先查看预演报告。NTQlean 只触碰 nt_data 目录内的文件，并生成操作清单 manifest。"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Label Content='输入 "清理" 以启用:'/>
                                <TextBox x:Name="ConfirmBox" Width="90"/>
                                <CheckBox x:Name="UnderstandBox" Content="我已检查预演报告并理解影响范围" Margin="16,0,0,0"/>
                                <Button Content="执行清理（回收站）" Margin="16,0,0,0"
                                        Style="{StaticResource DangerButton}" Click="OnExecuteCleanupClick"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
