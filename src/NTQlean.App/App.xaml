<Application x:Class="NTQlean.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark"/>
                <ui:ControlsDictionary/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="NtqTextPrimary" Color="#F2F2F2"/>
            <SolidColorBrush x:Key="NtqTextSecondary" Color="#A9A9B2"/>
            <SolidColorBrush x:Key="NtqSurface" Color="#202024"/>
            <SolidColorBrush x:Key="NtqSurfaceRaised" Color="#27272D"/>
            <SolidColorBrush x:Key="NtqSurfaceDeep" Color="#151518"/>
            <SolidColorBrush x:Key="NtqStroke" Color="#3A3A42"/>
            <SolidColorBrush x:Key="NtqSuccess" Color="#72C98E"/>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource NtqTextPrimary}"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <Style x:Key="FormLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource NtqTextSecondary}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,12,0,5"/>
            </Style>
            <Style x:Key="HintText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource NtqTextSecondary}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="GridCellText" TargetType="TextBlock">
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
            </Style>
            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="{StaticResource NtqSurfaceRaised}"/>
                <Setter Property="Foreground" Value="{StaticResource NtqTextPrimary}"/>
                <Setter Property="BorderBrush" Value="{StaticResource NtqStroke}"/>
                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                <Setter Property="Padding" Value="9,0"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
            </Style>
            <Style TargetType="DataGridCell">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="8,0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style x:Key="NtqDataGrid" TargetType="DataGrid">
                <Setter Property="Background" Value="{StaticResource NtqSurface}"/>
                <Setter Property="Foreground" Value="{StaticResource NtqTextPrimary}"/>
                <Setter Property="BorderBrush" Value="{StaticResource NtqStroke}"/>
                <Setter Property="RowBackground" Value="{StaticResource NtqSurface}"/>
                <Setter Property="AlternatingRowBackground" Value="{StaticResource NtqSurfaceRaised}"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource NtqStroke}"/>
                <Setter Property="RowHeight" Value="30"/>
                <Setter Property="ColumnHeaderHeight" Value="34"/>
            </Style>
            <Style x:Key="OutputTextBox" TargetType="TextBox">
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
                <Setter Property="FontFamily" Value="Consolas"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Background" Value="{StaticResource NtqSurfaceDeep}"/>
                <Setter Property="Foreground" Value="#D8D8DE"/>
                <Setter Property="BorderBrush" Value="{StaticResource NtqStroke}"/>
                <Setter Property="Padding" Value="8"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
